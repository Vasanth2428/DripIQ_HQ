# =============================================================================
# WEATHER API (Optional - for enhanced weather features)
# =============================================================================
# Get a free API key from: https://openweathermap.org/api
VITE_WEATHER_API_KEY=96be58b08efd5d4bd3f7a3bb27ec1345

# Alternative weather provider: https://weatherapi.com
# VITE_WEATHERAPI_KEY=your_weatherapi_key_here

# =============================================================================
# MAPS INTEGRATION (Optional - for future map features)
# =============================================================================
# Google Maps API key: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapbox access token: https://docs.mapbox.com/help/getting-started/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoic21pdGhjMDUiLCJhIjoiY21ldzhlNXNrMGhqcTJrczd1Mm05eHlpYSJ9.JqaKyjxeNxRumS4a_6dcTg

# =============================================================================
# NOTIFICATION SERVICES (Optional)
# =============================================================================
# SendGrid for email notifications: https://sendgrid.com
VITE_SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio for SMS notifications: https://www.twilio.com
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================
# Sentry for error tracking: https://sentry.io
VITE_SENTRY_DSN=your_sentry_dsn_here

# Google Analytics: https://analytics.google.com
VITE_GA_TRACKING_ID=your_google_analytics_id_here

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# Enable debug mode for additional logging
VITE_DEBUG_MODE=true

# API base URL (leave empty for relative URLs in production)
VITE_API_BASE_URL=

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# JWT secret for API authentication (generate a strong random string)
JWT_SECRET=your_jwt_secret_here

# CORS allowed origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable specific features
VITE_ENABLE_WEATHER_INTEGRATION=true
VITE_ENABLE_MAP_INTEGRATION=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_PANEL=false

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Your production domain (for CORS and security headers)
VITE_PRODUCTION_DOMAIN=https://fountain-command-center.vercel.app

# Vercel project settings
VERCEL_PROJECT_ID=prj_yxdsahXrCfcRQAAbsqIYJZDFQyH7
