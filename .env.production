# AquaSense Production Environment Variables
# These are the minimal required variables for deployment

# =============================================================================
# SUPABASE CONFIGURATION (Required - Update when ready)
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =============================================================================
# FEATURE FLAGS (Production Settings)
# =============================================================================
# Disable features that require API keys not yet available
VITE_ENABLE_WEATHER_INTEGRATION=false
VITE_ENABLE_MAP_INTEGRATION=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_PANEL=false

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
NODE_ENV=production
VITE_DEBUG_MODE=false
VITE_PRODUCTION_DOMAIN=https://your-app.vercel.app

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
CORS_ORIGINS=https://your-app.vercel.app